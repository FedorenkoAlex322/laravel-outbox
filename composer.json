{
    "name": "fedorenkoalex322/laravel-outbox",
    "description": "Outbox Pattern implementation for Laravel - reliable event delivery from database to external systems",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "outbox", "outbox-pattern", "event-driven", "reliability", "eventual-consistency"],
    "authors": [
        {
            "name": "dobro"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/queue": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "suggest": {
        "illuminate/redis": "Required for Redis-based locking (^10.0 || ^11.0 || ^12.0)"
    },
    "autoload": {
        "psr-4": {
            "FedorenkoAlex322\\LaravelOutbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FedorenkoAlex322\\LaravelOutbox\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FedorenkoAlex322\\LaravelOutbox\\OutboxServiceProvider"
            ],
            "aliases": {
                "Outbox": "FedorenkoAlex322\\LaravelOutbox\\Facades\\Outbox"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
